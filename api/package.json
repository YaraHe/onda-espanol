{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --env-file-if-exists=.env.local --test",
    "start": "node --env-file-if-exists=.env.local dist/index.js"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3"
  }
}
